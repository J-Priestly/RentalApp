<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:RentalApp.ViewModels"
             xmlns:models="clr-namespace:RentalApp.Database.Models;assembly=RentalApp.Database"
             x:Class="RentalApp.Views.RentalsPage"
             x:DataType="vm:RentalsViewModel"
             Title="{Binding Title}"
             BackgroundColor="{AppThemeBinding Light=#F2F2F2, Dark=#1A1A1A}">

    <Grid RowDefinitions="Auto,Auto,*">

        <!-- Segmented Tab Control -->
        <Border Grid.Row="0" Margin="16,14,16,0"
                BackgroundColor="{AppThemeBinding Light=#EBEBEB, Dark=#333333}"
                StrokeThickness="0" Padding="4">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="26"/>
            </Border.StrokeShape>
            <Grid ColumnDefinitions="*,*" ColumnSpacing="0">

                <Button Text="Incoming"
                        Command="{Binding ShowIncomingCommand}"
                        HeightRequest="44" FontSize="14" CornerRadius="22"
                        BackgroundColor="Transparent"
                        TextColor="{AppThemeBinding Light=#888888, Dark=#888888}"
                        FontAttributes="None">
                    <Button.Triggers>
                        <DataTrigger TargetType="Button"
                                     Binding="{Binding ShowingIncoming}" Value="True">
                            <Setter Property="BackgroundColor"
                                    Value="{AppThemeBinding Light=White, Dark=#4A4A4A}"/>
                            <Setter Property="TextColor" Value="#1877F2"/>
                            <Setter Property="FontAttributes" Value="Bold"/>
                        </DataTrigger>
                    </Button.Triggers>
                </Button>

                <Button Grid.Column="1"
                        Text="Outgoing"
                        Command="{Binding ShowOutgoingCommand}"
                        HeightRequest="44" FontSize="14" CornerRadius="22"
                        BackgroundColor="Transparent"
                        TextColor="{AppThemeBinding Light=#888888, Dark=#888888}"
                        FontAttributes="None">
                    <Button.Triggers>
                        <DataTrigger TargetType="Button"
                                     Binding="{Binding ShowingIncoming}" Value="False">
                            <Setter Property="BackgroundColor"
                                    Value="{AppThemeBinding Light=White, Dark=#4A4A4A}"/>
                            <Setter Property="TextColor" Value="#1877F2"/>
                            <Setter Property="FontAttributes" Value="Bold"/>
                        </DataTrigger>
                    </Button.Triggers>
                </Button>

            </Grid>
        </Border>

        <!-- Error Banner -->
        <Label Grid.Row="1"
               Text="{Binding ErrorMessage}"
               TextColor="#E53935"
               IsVisible="{Binding HasError}"
               Margin="16,6,16,0"
               FontSize="13"/>

        <!-- Lists -->
        <RefreshView Grid.Row="2"
                     Command="{Binding LoadRentalsCommand}"
                     IsRefreshing="{Binding IsBusy}"
                     Margin="0,8,0,0">
            <Grid>

                <!-- ── Incoming Rentals ── -->
                <CollectionView ItemsSource="{Binding IncomingRentals}"
                                IsVisible="{Binding ShowingIncoming}">
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="vm:RentalDisplayItem">
                            <Border Margin="12,4"
                                    BackgroundColor="{AppThemeBinding Light=White, Dark=#2A2A2A}"
                                    StrokeThickness="0" Padding="16">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="14"/>
                                </Border.StrokeShape>
                                <Border.Shadow>
                                    <Shadow Brush="#20000000" Offset="0,2" Radius="6" Opacity="0.2"/>
                                </Border.Shadow>
                                <VerticalStackLayout Spacing="10">

                                    <!-- Title + status badge -->
                                    <Grid ColumnDefinitions="*,Auto">
                                        <Label Text="{Binding ItemTitle}"
                                               FontSize="17" FontAttributes="Bold"
                                               TextColor="{AppThemeBinding Light=#222222, Dark=White}"
                                               VerticalOptions="Center"/>
                                        <Border Grid.Column="1"
                                                StrokeThickness="0" Padding="10,5"
                                                VerticalOptions="Center"
                                                BackgroundColor="{AppThemeBinding Light=#E3F2FD, Dark=#1A3A5C}">
                                            <Border.StrokeShape>
                                                <RoundRectangle CornerRadius="10"/>
                                            </Border.StrokeShape>
                                            <Border.Triggers>
                                                <DataTrigger TargetType="Border" Binding="{Binding Rental.Status}" Value="{x:Static models:RentalStatus.Approved}">
                                                    <Setter Property="BackgroundColor" Value="{AppThemeBinding Light=#E8F5E9, Dark=#1B3A1B}"/>
                                                </DataTrigger>
                                                <DataTrigger TargetType="Border" Binding="{Binding Rental.Status}" Value="{x:Static models:RentalStatus.Rejected}">
                                                    <Setter Property="BackgroundColor" Value="{AppThemeBinding Light=#FFEBEE, Dark=#3A1B1B}"/>
                                                </DataTrigger>
                                                <DataTrigger TargetType="Border" Binding="{Binding Rental.Status}" Value="{x:Static models:RentalStatus.OutForRent}">
                                                    <Setter Property="BackgroundColor" Value="{AppThemeBinding Light=#EDE7F6, Dark=#2A1A3A}"/>
                                                </DataTrigger>
                                                <DataTrigger TargetType="Border" Binding="{Binding Rental.Status}" Value="{x:Static models:RentalStatus.Overdue}">
                                                    <Setter Property="BackgroundColor" Value="{AppThemeBinding Light=#FFF3E0, Dark=#3A2A1A}"/>
                                                </DataTrigger>
                                                <DataTrigger TargetType="Border" Binding="{Binding Rental.Status}" Value="{x:Static models:RentalStatus.Returned}">
                                                    <Setter Property="BackgroundColor" Value="{AppThemeBinding Light=#E0F2F1, Dark=#1A3A3A}"/>
                                                </DataTrigger>
                                                <DataTrigger TargetType="Border" Binding="{Binding Rental.Status}" Value="{x:Static models:RentalStatus.Completed}">
                                                    <Setter Property="BackgroundColor" Value="{AppThemeBinding Light=#F5F5F5, Dark=#2A2A2A}"/>
                                                </DataTrigger>
                                            </Border.Triggers>
                                            <Label Text="{Binding Rental.Status}" FontSize="12" FontAttributes="Bold"
                                                   TextColor="{AppThemeBinding Light=#1565C0, Dark=#64B5F6}">
                                                <Label.Triggers>
                                                    <DataTrigger TargetType="Label" Binding="{Binding Rental.Status}" Value="{x:Static models:RentalStatus.Approved}">
                                                        <Setter Property="TextColor" Value="{AppThemeBinding Light=#2E7D32, Dark=#66BB6A}"/>
                                                    </DataTrigger>
                                                    <DataTrigger TargetType="Label" Binding="{Binding Rental.Status}" Value="{x:Static models:RentalStatus.Rejected}">
                                                        <Setter Property="TextColor" Value="{AppThemeBinding Light=#C62828, Dark=#EF9A9A}"/>
                                                    </DataTrigger>
                                                    <DataTrigger TargetType="Label" Binding="{Binding Rental.Status}" Value="{x:Static models:RentalStatus.OutForRent}">
                                                        <Setter Property="TextColor" Value="{AppThemeBinding Light=#4527A0, Dark=#B39DDB}"/>
                                                    </DataTrigger>
                                                    <DataTrigger TargetType="Label" Binding="{Binding Rental.Status}" Value="{x:Static models:RentalStatus.Overdue}">
                                                        <Setter Property="TextColor" Value="{AppThemeBinding Light=#E65100, Dark=#FFB74D}"/>
                                                    </DataTrigger>
                                                    <DataTrigger TargetType="Label" Binding="{Binding Rental.Status}" Value="{x:Static models:RentalStatus.Returned}">
                                                        <Setter Property="TextColor" Value="{AppThemeBinding Light=#00695C, Dark=#4DB6AC}"/>
                                                    </DataTrigger>
                                                    <DataTrigger TargetType="Label" Binding="{Binding Rental.Status}" Value="{x:Static models:RentalStatus.Completed}">
                                                        <Setter Property="TextColor" Value="{AppThemeBinding Light=#616161, Dark=#9E9E9E}"/>
                                                    </DataTrigger>
                                                </Label.Triggers>
                                            </Label>
                                        </Border>
                                    </Grid>

                                    <BoxView HeightRequest="1"
                                             BackgroundColor="{AppThemeBinding Light=#F0F0F0, Dark=#3A3A3A}"/>

                                    <Grid ColumnDefinitions="*,*">
                                        <VerticalStackLayout Spacing="2">
                                            <Label Text="FROM" FontSize="10" FontAttributes="Bold"
                                                   TextColor="{AppThemeBinding Light=#AAAAAA, Dark=#666666}"
                                                   CharacterSpacing="1"/>
                                            <Label Text="{Binding Rental.StartDate, StringFormat='{0:dd MMM yyyy}'}"
                                                   FontSize="15" FontAttributes="Bold"/>
                                        </VerticalStackLayout>
                                        <VerticalStackLayout Grid.Column="1" Spacing="2">
                                            <Label Text="TO" FontSize="10" FontAttributes="Bold"
                                                   TextColor="{AppThemeBinding Light=#AAAAAA, Dark=#666666}"
                                                   CharacterSpacing="1"/>
                                            <Label Text="{Binding Rental.EndDate, StringFormat='{0:dd MMM yyyy}'}"
                                                   FontSize="15" FontAttributes="Bold"/>
                                        </VerticalStackLayout>
                                    </Grid>

                                    <!-- Approve/Reject — only for Requested -->
                                    <Grid ColumnDefinitions="*,*" ColumnSpacing="10"
                                          IsVisible="False">
                                        <Grid.Triggers>
                                            <DataTrigger TargetType="Grid"
                                                         Binding="{Binding Rental.Status}"
                                                         Value="{x:Static models:RentalStatus.Requested}">
                                                <Setter Property="IsVisible" Value="True"/>
                                            </DataTrigger>
                                        </Grid.Triggers>
                                        <Button Text="✓  Approve"
                                                Command="{Binding Source={RelativeSource AncestorType={x:Type vm:RentalsViewModel}}, Path=ApproveRentalCommand}"
                                                CommandParameter="{Binding Rental}"
                                                HeightRequest="42" FontSize="14" FontAttributes="Bold"
                                                BackgroundColor="#4CAF50" TextColor="White" CornerRadius="21"/>
                                        <Button Grid.Column="1" Text="✕  Reject"
                                                Command="{Binding Source={RelativeSource AncestorType={x:Type vm:RentalsViewModel}}, Path=RejectRentalCommand}"
                                                CommandParameter="{Binding Rental}"
                                                HeightRequest="42" FontSize="14" FontAttributes="Bold"
                                                BackgroundColor="#E53935" TextColor="White" CornerRadius="21"/>
                                    </Grid>



                                </VerticalStackLayout>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                    <CollectionView.EmptyView>
                        <VerticalStackLayout VerticalOptions="Center" HorizontalOptions="Center"
                                             Spacing="10" Padding="40">
                            <Label Text="No incoming requests"
                                   FontSize="18" FontAttributes="Bold" HorizontalOptions="Center"
                                   TextColor="{AppThemeBinding Light=#666666, Dark=#AAAAAA}"/>
                            <Label Text="When someone wants to rent your items, their requests appear here"
                                   FontSize="14" HorizontalOptions="Center" HorizontalTextAlignment="Center"
                                   TextColor="{AppThemeBinding Light=#999999, Dark=#777777}"/>
                        </VerticalStackLayout>
                    </CollectionView.EmptyView>
                </CollectionView>

                <!-- ── Outgoing Rentals ── -->
                <CollectionView ItemsSource="{Binding OutgoingRentals}"
                                IsVisible="{Binding ShowingIncoming, Converter={StaticResource InvertedBoolConverter}}">
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="vm:RentalDisplayItem">
                            <Border Margin="12,4"
                                    BackgroundColor="{AppThemeBinding Light=White, Dark=#2A2A2A}"
                                    StrokeThickness="0" Padding="16">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="14"/>
                                </Border.StrokeShape>
                                <Border.Shadow>
                                    <Shadow Brush="#20000000" Offset="0,2" Radius="6" Opacity="0.2"/>
                                </Border.Shadow>
                                <VerticalStackLayout Spacing="10">

                                    <Grid ColumnDefinitions="*,Auto">
                                        <Label Text="{Binding ItemTitle}"
                                               FontSize="17" FontAttributes="Bold"
                                               TextColor="{AppThemeBinding Light=#222222, Dark=White}"
                                               VerticalOptions="Center"/>
                                        <Border Grid.Column="1"
                                                StrokeThickness="0" Padding="10,5"
                                                VerticalOptions="Center"
                                                BackgroundColor="{AppThemeBinding Light=#E3F2FD, Dark=#1A3A5C}">
                                            <Border.StrokeShape>
                                                <RoundRectangle CornerRadius="10"/>
                                            </Border.StrokeShape>
                                            <Border.Triggers>
                                                <DataTrigger TargetType="Border" Binding="{Binding Rental.Status}" Value="{x:Static models:RentalStatus.Approved}">
                                                    <Setter Property="BackgroundColor" Value="{AppThemeBinding Light=#E8F5E9, Dark=#1B3A1B}"/>
                                                </DataTrigger>
                                                <DataTrigger TargetType="Border" Binding="{Binding Rental.Status}" Value="{x:Static models:RentalStatus.Rejected}">
                                                    <Setter Property="BackgroundColor" Value="{AppThemeBinding Light=#FFEBEE, Dark=#3A1B1B}"/>
                                                </DataTrigger>
                                                <DataTrigger TargetType="Border" Binding="{Binding Rental.Status}" Value="{x:Static models:RentalStatus.OutForRent}">
                                                    <Setter Property="BackgroundColor" Value="{AppThemeBinding Light=#EDE7F6, Dark=#2A1A3A}"/>
                                                </DataTrigger>
                                                <DataTrigger TargetType="Border" Binding="{Binding Rental.Status}" Value="{x:Static models:RentalStatus.Overdue}">
                                                    <Setter Property="BackgroundColor" Value="{AppThemeBinding Light=#FFF3E0, Dark=#3A2A1A}"/>
                                                </DataTrigger>
                                                <DataTrigger TargetType="Border" Binding="{Binding Rental.Status}" Value="{x:Static models:RentalStatus.Returned}">
                                                    <Setter Property="BackgroundColor" Value="{AppThemeBinding Light=#E0F2F1, Dark=#1A3A3A}"/>
                                                </DataTrigger>
                                                <DataTrigger TargetType="Border" Binding="{Binding Rental.Status}" Value="{x:Static models:RentalStatus.Completed}">
                                                    <Setter Property="BackgroundColor" Value="{AppThemeBinding Light=#F5F5F5, Dark=#2A2A2A}"/>
                                                </DataTrigger>
                                            </Border.Triggers>
                                            <Label Text="{Binding Rental.Status}" FontSize="12" FontAttributes="Bold"
                                                   TextColor="{AppThemeBinding Light=#1565C0, Dark=#64B5F6}">
                                                <Label.Triggers>
                                                    <DataTrigger TargetType="Label" Binding="{Binding Rental.Status}" Value="{x:Static models:RentalStatus.Approved}">
                                                        <Setter Property="TextColor" Value="{AppThemeBinding Light=#2E7D32, Dark=#66BB6A}"/>
                                                    </DataTrigger>
                                                    <DataTrigger TargetType="Label" Binding="{Binding Rental.Status}" Value="{x:Static models:RentalStatus.Rejected}">
                                                        <Setter Property="TextColor" Value="{AppThemeBinding Light=#C62828, Dark=#EF9A9A}"/>
                                                    </DataTrigger>
                                                    <DataTrigger TargetType="Label" Binding="{Binding Rental.Status}" Value="{x:Static models:RentalStatus.OutForRent}">
                                                        <Setter Property="TextColor" Value="{AppThemeBinding Light=#4527A0, Dark=#B39DDB}"/>
                                                    </DataTrigger>
                                                    <DataTrigger TargetType="Label" Binding="{Binding Rental.Status}" Value="{x:Static models:RentalStatus.Overdue}">
                                                        <Setter Property="TextColor" Value="{AppThemeBinding Light=#E65100, Dark=#FFB74D}"/>
                                                    </DataTrigger>
                                                    <DataTrigger TargetType="Label" Binding="{Binding Rental.Status}" Value="{x:Static models:RentalStatus.Returned}">
                                                        <Setter Property="TextColor" Value="{AppThemeBinding Light=#00695C, Dark=#4DB6AC}"/>
                                                    </DataTrigger>
                                                    <DataTrigger TargetType="Label" Binding="{Binding Rental.Status}" Value="{x:Static models:RentalStatus.Completed}">
                                                        <Setter Property="TextColor" Value="{AppThemeBinding Light=#616161, Dark=#9E9E9E}"/>
                                                    </DataTrigger>
                                                </Label.Triggers>
                                            </Label>
                                        </Border>
                                    </Grid>

                                    <BoxView HeightRequest="1"
                                             BackgroundColor="{AppThemeBinding Light=#F0F0F0, Dark=#3A3A3A}"/>

                                    <Grid ColumnDefinitions="*,*">
                                        <VerticalStackLayout Spacing="2">
                                            <Label Text="FROM" FontSize="10" FontAttributes="Bold"
                                                   TextColor="{AppThemeBinding Light=#AAAAAA, Dark=#666666}"
                                                   CharacterSpacing="1"/>
                                            <Label Text="{Binding Rental.StartDate, StringFormat='{0:dd MMM yyyy}'}"
                                                   FontSize="15" FontAttributes="Bold"/>
                                        </VerticalStackLayout>
                                        <VerticalStackLayout Grid.Column="1" Spacing="2">
                                            <Label Text="TO" FontSize="10" FontAttributes="Bold"
                                                   TextColor="{AppThemeBinding Light=#AAAAAA, Dark=#666666}"
                                                   CharacterSpacing="1"/>
                                            <Label Text="{Binding Rental.EndDate, StringFormat='{0:dd MMM yyyy}'}"
                                                   FontSize="15" FontAttributes="Bold"/>
                                        </VerticalStackLayout>
                                    </Grid>

                                    <Border BackgroundColor="{AppThemeBinding Light=#F0F7FF, Dark=#1A2A3A}"
                                            StrokeThickness="0" Padding="14,10">
                                        <Border.StrokeShape>
                                            <RoundRectangle CornerRadius="10"/>
                                        </Border.StrokeShape>
                                        <HorizontalStackLayout Spacing="4">
                                            <Label Text="Total:"
                                                   FontSize="14" VerticalOptions="Center"
                                                   TextColor="{AppThemeBinding Light=#555555, Dark=#BBBBBB}"/>
                                            <Label Text="{Binding Rental.TotalPrice, StringFormat='£{0:F2}'}"
                                                   FontSize="18" FontAttributes="Bold"
                                                   VerticalOptions="Center"
                                                   TextColor="{AppThemeBinding Light=#1565C0, Dark=#64B5F6}"/>
                                        </HorizontalStackLayout>
                                    </Border>

                                    <!-- Leave Review — only after rental is Completed -->
                                    <Button Text="⭐ Leave Review"
                                            Command="{Binding Source={RelativeSource AncestorType={x:Type vm:RentalsViewModel}}, Path=LeaveReviewCommand}"
                                            CommandParameter="{Binding Rental}"
                                            HeightRequest="42" FontSize="14" FontAttributes="Bold"
                                            BackgroundColor="#FF9800" TextColor="White" CornerRadius="21"
                                            IsVisible="False">
                                        <Button.Triggers>
                                            <DataTrigger TargetType="Button" Binding="{Binding Rental.Status}" Value="{x:Static models:RentalStatus.Completed}">
                                                <Setter Property="IsVisible" Value="True"/>
                                            </DataTrigger>
                                        </Button.Triggers>
                                    </Button>

                                </VerticalStackLayout>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                    <CollectionView.EmptyView>
                        <VerticalStackLayout VerticalOptions="Center" HorizontalOptions="Center"
                                             Spacing="10" Padding="40">
                            <Label Text="No outgoing rentals"
                                   FontSize="18" FontAttributes="Bold" HorizontalOptions="Center"
                                   TextColor="{AppThemeBinding Light=#666666, Dark=#AAAAAA}"/>
                            <Label Text="Browse items and send a rental request to get started"
                                   FontSize="14" HorizontalOptions="Center" HorizontalTextAlignment="Center"
                                   TextColor="{AppThemeBinding Light=#999999, Dark=#777777}"/>
                        </VerticalStackLayout>
                    </CollectionView.EmptyView>
                </CollectionView>

            </Grid>
        </RefreshView>

        <!-- Loading Overlay -->
        <Grid Grid.Row="0" Grid.RowSpan="3"
              IsVisible="{Binding IsBusy}"
              InputTransparent="True">
            <BoxView BackgroundColor="{AppThemeBinding Light=#66F2F2F2, Dark=#661A1A1A}"/>
            <Border BackgroundColor="{AppThemeBinding Light=White, Dark=#2A2A2A}"
                    StrokeThickness="0"
                    HorizontalOptions="Center" VerticalOptions="Center"
                    Padding="36,28">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="18"/>
                </Border.StrokeShape>
                <Border.Shadow>
                    <Shadow Brush="#40000000" Offset="0,4" Radius="16" Opacity="0.3"/>
                </Border.Shadow>
                <VerticalStackLayout Spacing="14" HorizontalOptions="Center">
                    <ActivityIndicator IsRunning="True" Color="#1877F2"
                                       WidthRequest="44" HeightRequest="44"
                                       HorizontalOptions="Center"/>
                    <Label Text="Loading…" FontSize="14"
                           TextColor="{AppThemeBinding Light=#666666, Dark=#AAAAAA}"
                           HorizontalOptions="Center"/>
                </VerticalStackLayout>
            </Border>
        </Grid>

    </Grid>
</ContentPage>
