<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:RentalApp.ViewModels"
             x:Class="RentalApp.Views.ProfilePage"
             x:DataType="vm:ProfileViewModel"
             Title="{Binding Title}"
             BackgroundColor="{AppThemeBinding Light=#F2F2F2, Dark=#1A1A1A}">

    <ScrollView>
        <VerticalStackLayout Spacing="0">

            <!-- ── Avatar Header ── -->
            <Border StrokeThickness="0">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#1E3A8A" Offset="0.0"/>
                        <GradientStop Color="#1877F2" Offset="1.0"/>
                    </LinearGradientBrush>
                </Border.Background>
                <VerticalStackLayout Spacing="10" HorizontalOptions="Center"
                                     Padding="24,44,24,36">

                    <!-- Initials circle -->
                    <Border BackgroundColor="#FFFFFF25"
                            StrokeThickness="2"
                            Stroke="#FFFFFF50"
                            WidthRequest="88" HeightRequest="88"
                            HorizontalOptions="Center">
                        <Border.StrokeShape>
                            <Ellipse/>
                        </Border.StrokeShape>
                        <Label Text="{Binding Initials}"
                               FontSize="32" FontAttributes="Bold"
                               TextColor="White"
                               HorizontalOptions="Center"
                               VerticalOptions="Center"/>
                    </Border>

                    <!-- Full name -->
                    <Label Text="{Binding CurrentUser.FullName, FallbackValue='—'}"
                           FontSize="22" FontAttributes="Bold"
                           TextColor="White"
                           HorizontalOptions="Center"/>

                    <!-- Email -->
                    <Label Text="{Binding CurrentUser.Email, FallbackValue=''}"
                           FontSize="14" TextColor="White" Opacity="0.8"
                           HorizontalOptions="Center"/>

                </VerticalStackLayout>
            </Border>

            <!-- ── Account Information Card ── -->
            <Border Margin="16,16,16,0"
                    BackgroundColor="{AppThemeBinding Light=White, Dark=#2A2A2A}"
                    StrokeThickness="0" Padding="20">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="14"/>
                </Border.StrokeShape>
                <Border.Shadow>
                    <Shadow Brush="#20000000" Offset="0,2" Radius="6" Opacity="0.15"/>
                </Border.Shadow>
                <VerticalStackLayout Spacing="0">

                    <Label Text="ACCOUNT INFORMATION"
                           FontSize="11" FontAttributes="Bold"
                           CharacterSpacing="1.5"
                           TextColor="{AppThemeBinding Light=#AAAAAA, Dark=#666666}"
                           Margin="0,0,0,4"/>

                    <!-- First Name -->
                    <Grid ColumnDefinitions="130,*" Padding="0,13">
                        <Label Text="First name" FontSize="14"
                               TextColor="{AppThemeBinding Light=#888888, Dark=#888888}"
                               VerticalOptions="Center"/>
                        <Label Grid.Column="1"
                               Text="{Binding CurrentUser.FirstName, FallbackValue='—'}"
                               FontSize="14" FontAttributes="Bold"
                               VerticalOptions="Center"/>
                    </Grid>
                    <BoxView HeightRequest="1"
                             BackgroundColor="{AppThemeBinding Light=#F0F0F0, Dark=#3A3A3A}"/>

                    <!-- Last Name -->
                    <Grid ColumnDefinitions="130,*" Padding="0,13">
                        <Label Text="Last name" FontSize="14"
                               TextColor="{AppThemeBinding Light=#888888, Dark=#888888}"
                               VerticalOptions="Center"/>
                        <Label Grid.Column="1"
                               Text="{Binding CurrentUser.LastName, FallbackValue='—'}"
                               FontSize="14" FontAttributes="Bold"
                               VerticalOptions="Center"/>
                    </Grid>
                    <BoxView HeightRequest="1"
                             BackgroundColor="{AppThemeBinding Light=#F0F0F0, Dark=#3A3A3A}"/>

                    <!-- Email -->
                    <Grid ColumnDefinitions="130,*" Padding="0,13">
                        <Label Text="Email" FontSize="14"
                               TextColor="{AppThemeBinding Light=#888888, Dark=#888888}"
                               VerticalOptions="Center"/>
                        <Label Grid.Column="1"
                               Text="{Binding CurrentUser.Email, FallbackValue='—'}"
                               FontSize="14" FontAttributes="Bold"
                               VerticalOptions="Center"
                               LineBreakMode="TailTruncation"/>
                    </Grid>
                    <BoxView HeightRequest="1"
                             BackgroundColor="{AppThemeBinding Light=#F0F0F0, Dark=#3A3A3A}"/>

                    <!-- Member Since -->
                    <Grid ColumnDefinitions="130,*" Padding="0,13">
                        <Label Text="Member since" FontSize="14"
                               TextColor="{AppThemeBinding Light=#888888, Dark=#888888}"
                               VerticalOptions="Center"/>
                        <Label Grid.Column="1"
                               Text="{Binding CurrentUser.CreatedAt, StringFormat='{0:MMMM yyyy}', FallbackValue='—'}"
                               FontSize="14" FontAttributes="Bold"
                               VerticalOptions="Center"/>
                    </Grid>

                </VerticalStackLayout>
            </Border>

            <!-- ── Security Card ── -->
            <Border Margin="16,16,16,32"
                    BackgroundColor="{AppThemeBinding Light=White, Dark=#2A2A2A}"
                    StrokeThickness="0" Padding="20">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="14"/>
                </Border.StrokeShape>
                <Border.Shadow>
                    <Shadow Brush="#20000000" Offset="0,2" Radius="6" Opacity="0.15"/>
                </Border.Shadow>
                <VerticalStackLayout Spacing="0">

                    <Label Text="SECURITY"
                           FontSize="11" FontAttributes="Bold"
                           CharacterSpacing="1.5"
                           TextColor="{AppThemeBinding Light=#AAAAAA, Dark=#666666}"
                           Margin="0,0,0,4"/>

                    <!-- Change password row (always visible) -->
                    <Grid ColumnDefinitions="*,Auto" Padding="0,10">
                        <VerticalStackLayout VerticalOptions="Center" Spacing="2">
                            <Label Text="Password" FontSize="15" FontAttributes="Bold"/>
                            <Label Text="Update your account password"
                                   FontSize="12"
                                   TextColor="{AppThemeBinding Light=#888888, Dark=#888888}"/>
                        </VerticalStackLayout>
                        <Button Grid.Column="1"
                                Command="{Binding TogglePasswordChangeModeCommand}"
                                BackgroundColor="Transparent"
                                TextColor="#1877F2"
                                FontSize="14" FontAttributes="Bold"
                                Padding="8,0"
                                Text="Edit">
                            <Button.Triggers>
                                <DataTrigger TargetType="Button"
                                             Binding="{Binding IsChangingPassword}" Value="True">
                                    <Setter Property="Text" Value="Cancel"/>
                                    <Setter Property="TextColor" Value="#E53935"/>
                                </DataTrigger>
                            </Button.Triggers>
                        </Button>
                    </Grid>

                    <!-- Expandable password change form -->
                    <VerticalStackLayout IsVisible="{Binding IsChangingPassword}"
                                         Spacing="14" Margin="0,4,0,4">
                        <BoxView HeightRequest="1"
                                 BackgroundColor="{AppThemeBinding Light=#F0F0F0, Dark=#3A3A3A}"/>

                        <!-- Current Password -->
                        <VerticalStackLayout Spacing="6">
                            <Label Text="Current Password" FontSize="13" FontAttributes="Bold"
                                   TextColor="{AppThemeBinding Light=#444444, Dark=#BBBBBB}"/>
                            <Border BackgroundColor="{AppThemeBinding Light=#F8F8F8, Dark=#333333}"
                                    StrokeThickness="1"
                                    Stroke="{AppThemeBinding Light=#E0E0E0, Dark=#555555}"
                                    Padding="4,0">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="10"/>
                                </Border.StrokeShape>
                                <Entry Text="{Binding CurrentPassword}"
                                       IsPassword="True"
                                       Placeholder="Current password"
                                       BackgroundColor="Transparent"/>
                            </Border>
                        </VerticalStackLayout>

                        <!-- New Password -->
                        <VerticalStackLayout Spacing="6">
                            <Label Text="New Password" FontSize="13" FontAttributes="Bold"
                                   TextColor="{AppThemeBinding Light=#444444, Dark=#BBBBBB}"/>
                            <Border BackgroundColor="{AppThemeBinding Light=#F8F8F8, Dark=#333333}"
                                    StrokeThickness="1"
                                    Stroke="{AppThemeBinding Light=#E0E0E0, Dark=#555555}"
                                    Padding="4,0">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="10"/>
                                </Border.StrokeShape>
                                <Entry Text="{Binding NewPassword}"
                                       IsPassword="True"
                                       Placeholder="At least 6 characters"
                                       BackgroundColor="Transparent"/>
                            </Border>
                        </VerticalStackLayout>

                        <!-- Confirm New Password -->
                        <VerticalStackLayout Spacing="6">
                            <Label Text="Confirm New Password" FontSize="13" FontAttributes="Bold"
                                   TextColor="{AppThemeBinding Light=#444444, Dark=#BBBBBB}"/>
                            <Border BackgroundColor="{AppThemeBinding Light=#F8F8F8, Dark=#333333}"
                                    StrokeThickness="1"
                                    Stroke="{AppThemeBinding Light=#E0E0E0, Dark=#555555}"
                                    Padding="4,0">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="10"/>
                                </Border.StrokeShape>
                                <Entry Text="{Binding ConfirmNewPassword}"
                                       IsPassword="True"
                                       Placeholder="Repeat new password"
                                       BackgroundColor="Transparent"/>
                            </Border>
                        </VerticalStackLayout>

                        <!-- Error -->
                        <Border BackgroundColor="{AppThemeBinding Light=#FFEBEE, Dark=#1B0000}"
                                StrokeThickness="1"
                                Stroke="{AppThemeBinding Light=#F44336, Dark=#EF5350}"
                                Padding="14,10"
                                IsVisible="{Binding HasError}">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="10"/>
                            </Border.StrokeShape>
                            <Label Text="{Binding ErrorMessage}"
                                   TextColor="{AppThemeBinding Light=#D32F2F, Dark=#EF5350}"
                                   FontSize="14"/>
                        </Border>

                        <!-- Submit -->
                        <Button Text="Update Password"
                                Command="{Binding ChangePasswordCommand}"
                                BackgroundColor="#1877F2" TextColor="White"
                                HeightRequest="50" CornerRadius="25"
                                FontSize="15" FontAttributes="Bold"/>

                        <!-- Activity Indicator -->
                        <ActivityIndicator IsVisible="{Binding IsBusy}"
                                           IsRunning="{Binding IsBusy}"
                                           Color="#1877F2"
                                           HorizontalOptions="Center"/>

                    </VerticalStackLayout>

                </VerticalStackLayout>
            </Border>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
