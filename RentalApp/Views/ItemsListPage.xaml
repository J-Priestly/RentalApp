<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:RentalApp.ViewModels"
             xmlns:models="clr-namespace:RentalApp.Database.Models;assembly=RentalApp.Database"
             x:Class="RentalApp.Views.ItemsListPage"
             x:DataType="vm:ItemsListViewModel"
             Title="{Binding Title}"
             BackgroundColor="{AppThemeBinding Light=#F2F2F2, Dark=#1A1A1A}">

	<ContentPage.Resources>
		<LinearItemsLayout x:Key="VerticalList" Orientation="Vertical" ItemSpacing="0"/>
		<GridItemsLayout x:Key="TwoColumnGrid" Orientation="Vertical" Span="2" HorizontalItemSpacing="8" VerticalItemSpacing="8"/>
	</ContentPage.Resources>

	<Grid RowDefinitions="Auto,Auto,*">

		<!-- Search Bar -->
		<Border Grid.Row="0" Margin="12,12,12,0"
                BackgroundColor="{AppThemeBinding Light=White, Dark=#2A2A2A}"
                StrokeThickness="0"
                Padding="4">
			<Border.StrokeShape>
				<RoundRectangle CornerRadius="24"/>
			</Border.StrokeShape>
			<SearchBar Placeholder="Search by title, category or description..."
                       Text="{Binding SearchText}"
                       BackgroundColor="Transparent"/>
		</Border>

		<!-- Action Buttons -->
		<Grid Grid.Row="1" ColumnDefinitions="*,*" ColumnSpacing="8" Margin="12,10">
			<Button Text="+ List Item"
                    Command="{Binding GoToCreateItemCommand}"
                    HeightRequest="48"
                    FontAttributes="Bold"
                    FontSize="15"
                    BackgroundColor="#1877F2"
                    TextColor="White"
                    CornerRadius="24"/>
			<Button Grid.Column="1"
                    Text="📍 Nearby"
                    Command="{Binding GoToNearbyItemsCommand}"
                    HeightRequest="48"
                    FontAttributes="Bold"
                    FontSize="15"
                    BackgroundColor="#4CAF50"
                    TextColor="White"
                    CornerRadius="24"/>
		</Grid>

		<!-- Items Grid -->
		<RefreshView Grid.Row="2"
                     Command="{Binding LoadItemsCommand}"
                     IsRefreshing="{Binding IsBusy}">

			<CollectionView ItemsSource="{Binding Items}"
                            ItemsLayout="{OnIdiom Phone={StaticResource VerticalList}, Default={StaticResource TwoColumnGrid}}">

				<CollectionView.ItemTemplate>
					<DataTemplate x:DataType="models:Item">
						<Border Margin="8,4"
                                BackgroundColor="{AppThemeBinding Light=White, Dark=#2A2A2A}"
                                StrokeThickness="0"
                                Padding="0">
							<Border.StrokeShape>
								<RoundRectangle CornerRadius="12"/>
							</Border.StrokeShape>
							<Border.Shadow>
								<Shadow Brush="#20000000" Offset="0,2" Radius="8" Opacity="0.3"/>
							</Border.Shadow>
							<Border.GestureRecognizers>
								<TapGestureRecognizer
                                    Command="{Binding Source={RelativeSource AncestorType={x:Type vm:ItemsListViewModel}}, Path=GoToItemDetailCommand}"
                                    CommandParameter="{Binding .}"/>
							</Border.GestureRecognizers>

							<Grid RowDefinitions="160,Auto">
								<!-- Placeholder Image Area — gradient + category label -->
								<Border Grid.Row="0" StrokeThickness="0">
									<Border.StrokeShape>
										<RoundRectangle CornerRadius="12,12,0,0"/>
									</Border.StrokeShape>
									<Border.Background>
										<LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
											<GradientStop Color="#DBEAFE" Offset="0.0"/>
											<GradientStop Color="#BFDBFE" Offset="1.0"/>
										</LinearGradientBrush>
									</Border.Background>
									<Label Text="{Binding Category}"
                                           FontSize="13" FontAttributes="Bold"
                                           HorizontalOptions="Center"
                                           VerticalOptions="Center"
                                           TextColor="#1877F2"
                                           Opacity="0.65"/>
								</Border>

								<!-- Item Info -->
								<VerticalStackLayout Grid.Row="1" Padding="12,10" Spacing="4">
									<Label Text="{Binding DailyRate, StringFormat='£{0:F2}/day'}"
                                           FontSize="20"
                                           FontAttributes="Bold"
                                           TextColor="{AppThemeBinding Light=#222222, Dark=White}"/>
									<Label Text="{Binding Title}"
                                           FontSize="15"
                                           TextColor="{AppThemeBinding Light=#444444, Dark=#CCCCCC}"
                                           MaxLines="2"
                                           LineBreakMode="TailTruncation"/>
									<HorizontalStackLayout Spacing="6" Margin="0,4,0,0">
										<Border BackgroundColor="{AppThemeBinding Light=#E3F2FD, Dark=#1A3A5C}"
                                                StrokeThickness="0"
                                                Padding="8,4">
											<Border.StrokeShape>
												<RoundRectangle CornerRadius="10"/>
											</Border.StrokeShape>
											<Label Text="{Binding Category}"
                                                   FontSize="12"
                                                   TextColor="{AppThemeBinding Light=#1565C0, Dark=#64B5F6}"/>
										</Border>
									</HorizontalStackLayout>
								</VerticalStackLayout>
							</Grid>

						</Border>
					</DataTemplate>
				</CollectionView.ItemTemplate>

				<CollectionView.EmptyView>
					<VerticalStackLayout VerticalOptions="Center" HorizontalOptions="Center" Spacing="10" Padding="40">
						<Label Text="No items listed yet"
                               FontSize="20" FontAttributes="Bold"
                               HorizontalOptions="Center"
                               TextColor="{AppThemeBinding Light=#666666, Dark=#AAAAAA}"/>
						<Label Text="Pull down to refresh or tap 'Rent Something' to list your first item!"
                               FontSize="14"
                               HorizontalOptions="Center"
                               HorizontalTextAlignment="Center"
                               TextColor="{AppThemeBinding Light=#999999, Dark=#777777}"/>
					</VerticalStackLayout>
				</CollectionView.EmptyView>

			</CollectionView>

		</RefreshView>

		<!-- Loading Overlay -->
		<Grid Grid.Row="0" Grid.RowSpan="3"
              IsVisible="{Binding IsBusy}"
              InputTransparent="True">
			<BoxView BackgroundColor="{AppThemeBinding Light=#66F2F2F2, Dark=#661A1A1A}"/>
			<Border BackgroundColor="{AppThemeBinding Light=White, Dark=#2A2A2A}"
                    StrokeThickness="0"
                    HorizontalOptions="Center" VerticalOptions="Center"
                    Padding="36,28">
				<Border.StrokeShape>
					<RoundRectangle CornerRadius="18"/>
				</Border.StrokeShape>
				<Border.Shadow>
					<Shadow Brush="#40000000" Offset="0,4" Radius="16" Opacity="0.3"/>
				</Border.Shadow>
				<VerticalStackLayout Spacing="14" HorizontalOptions="Center">
					<ActivityIndicator IsRunning="True" Color="#1877F2"
                                       WidthRequest="44" HeightRequest="44"
                                       HorizontalOptions="Center"/>
					<Label Text="Loading…" FontSize="14"
                           TextColor="{AppThemeBinding Light=#666666, Dark=#AAAAAA}"
                           HorizontalOptions="Center"/>
				</VerticalStackLayout>
			</Border>
		</Grid>

	</Grid>

</ContentPage>
